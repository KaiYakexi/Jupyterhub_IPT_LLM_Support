# Dockerfile.flask - Flask log service (askLLM)
#
# This was previously baked into the Hub container and run as a managed subprocess.
# In K8s, it's a standalone deployment so it can restart/scale independently.
#
# It still needs the jupyterhub package for HubAuth (request authentication),
# but it does NOT run JupyterHub itself.

FROM python:3.12-slim

WORKDIR /srv/logservice

RUN pip install --no-cache \
    flask==3.1.3 \
    pymongo==4.16.0 \
    openai==2.24.0 \
    requests==2.32.5 \
    werkzeug==3.1.6 \
    gunicorn==25.1.0 \
    flask-limiter==4.1.1 \
    jupyterhub

# When built from repo root: docker build -f infra/docker/Dockerfile.flask .
COPY infra/docker/logService.py .
COPY solutions.py .
COPY prompts/ ./prompts/

CMD ["gunicorn", "--bind", "0.0.0.0:10101", "--workers", "1", "--timeout", "120", "logService:app"]
