# terraform.tfvars.template — Copy to terraform.tfvars and fill in your values
#
# Usage:
#   cp terraform.tfvars.template terraform.tfvars
#   # Edit terraform.tfvars with your values
#   terraform plan

# Required: base name for all resources. Must be globally unique for ACR
# (ACR name is derived by stripping hyphens: "my-project" + "dev" → "myprojectdev")
project_name = "my-jupyterhub-project"

# Azure region — run `az account list-locations -o table` to see options
location = "westeurope"

# Environment name — used in resource naming (e.g., rg-my-project-dev)
environment = "dev"

# AKS node pool VM size — run `az vm list-sizes -l <location> -o table` to see options
# Standard_B2s_v2: 2 vCPU, 4GB RAM (cheapest option suitable for small deployments)
# Standard_B4ms:   4 vCPU, 16GB RAM (better for production)
vm_size = "Standard_B2s_v2"

# AKS autoscaler bounds
node_min_count = 1
node_max_count = 3

# ACR SKU: Basic (cheapest), Standard, or Premium
acr_sku = "Basic"
