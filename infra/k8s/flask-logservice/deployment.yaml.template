# deployment.yaml.template — Flask askLLM service
#
# This is an envsubst template. Do NOT edit deployment.yaml directly — it is generated.
#
# Usage:
#   envsubst < deployment.yaml.template > deployment.yaml
#   kubectl apply -f deployment.yaml
#
# Required environment variables (set in env.deploy):
#   ACR_LOGIN_SERVER, K8S_NAMESPACE

apiVersion: apps/v1
kind: Deployment
metadata:
  name: flask-logservice
  namespace: ${K8S_NAMESPACE}
  labels:
    app: flask-logservice
spec:
  replicas: 1
  selector:
    matchLabels:
      app: flask-logservice
  template:
    metadata:
      labels:
        app: flask-logservice
        hub.jupyter.org/network-access-hub: "true"
        hub.jupyter.org/network-access-proxy-http: "true"
    spec:
      containers:
        - name: flask-logservice
          image: ${ACR_LOGIN_SERVER}/flask-logservice:latest
          ports:
            - containerPort: 10101
          env:
            - name: JUPYTERHUB_API_TOKEN
              valueFrom:
                secretKeyRef:
                  name: jupyterhub-secrets
                  key: jupyterhub-askllm-api-token
            - name: JUPYTERHUB_API_URL
              value: "http://hub:8081/hub/api"
            - name: JUPYTERHUB_SERVICE_PREFIX
              value: "/services/askLLM/"
            # Must match fullnameOverride in mongodb-values.yaml
            - name: MONGO_HOST
              value: "mongodb"
            - name: MONGO_PORT
              value: "27017"
          volumeMounts:
            # Mount at /app/secrets instead of /run/secrets to avoid
            # conflicting with K8s service account mount at /var/run/secrets
            - name: secrets
              mountPath: /app/secrets
              readOnly: true
          resources:
            limits:
              memory: "512Mi"
              cpu: "500m"
            requests:
              memory: "128Mi"
              cpu: "100m"
      volumes:
        - name: secrets
          secret:
            secretName: jupyterhub-secrets
            items:
              - key: openai-api-key
                path: openai_api_key
              - key: mongo-username
                path: mongo_username
              - key: mongo-password
                path: mongo_password
              - key: flask-secret-key
                path: flask_secret_key
